{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [{ "command": "isletctl hook cursor --wait 300", "timeout": 330 }],
    "beforeMCPExecution":   [{ "command": "isletctl hook cursor --wait 300", "timeout": 330 }],
    "afterShellExecution":  [{ "command": "isletctl hook cursor" }],
    "afterMCPExecution":    [{ "command": "isletctl hook cursor" }],
    "stop":                 [{ "command": "isletctl hook cursor" }]
  }
}
