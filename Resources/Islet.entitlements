<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Needed under the hardened runtime to send Apple Events to Music and Spotify. -->
    <key>com.apple.security.automation.apple-events</key><true/>
    <!-- Needed under the hardened runtime for EventKit (Calendar, and Reminders with it). Without
         it macOS refuses access without ever showing the prompt. -->
    <key>com.apple.security.personal-information.calendars</key><true/>
    <!-- Needed under the hardened runtime for CoreLocation, used only for "Weather where I am". -->
    <key>com.apple.security.personal-information.location</key><true/>
</dict>
</plist>
